{
  "name": "gabriel-nbs-portfolio",
  "version": "1.1.0",
  "priority": [
    "DESIGN.md",
    "styles.json",
    "provided screenshots",
    "existing components",
    "premium references"
  ],
  "colors": {
    "canvas": "#f7f7f5",
    "paper": "#ffffff",
    "ink": "#18181b",
    "muted": "#68645f",
    "line": "#dedbd4",
    "soft": "#eeece7",
    "accent": "#a43f2f",
    "accentDark": "#7f2d22"
  },
  "spacing": {
    "site": "min(1180px, calc(100% - 2rem))",
    "grid": "clamp(1.25rem, 3vw, 3rem)",
    "section": "clamp(5rem, 10vw, 9rem)",
    "sectionTight": "clamp(3rem, 7vw, 5rem)",
    "heroMin": "calc(86svh - 4.25rem)",
    "caseHeroMin": "calc(88svh - 4.25rem)",
    "heroStart": "clamp(3rem, 6vw, 5rem)",
    "heroEnd": "clamp(2rem, 5vw, 4rem)",
    "caseHeroY": "clamp(3rem, 7vw, 6rem)",
    "headingGap": "clamp(2rem, 5vw, 4rem)",
    "card": "clamp(1.25rem, 3vw, 2rem)",
    "cardBody": "1.1rem",
    "contactIndent": "clamp(1.5rem, 4vw, 3rem)",
    "touch": "2.8rem",
    "bridge": "5rem",
    "bridgeBand": "clamp(8rem, 18vw, 14rem)",
    "serviceCard": "14rem",
    "buttonX": "1rem",
    "buttonY": "0.82rem",
    "navGap": "clamp(0.75rem, 2vw, 1.5rem)",
    "navPad": "0.45rem",
    "navX": "0.75rem",
    "navY": "0.45rem",
    "tagX": "0.58rem",
    "tagY": "0.35rem"
  },
  "typography": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "sizes": {
      "hero": "clamp(3.25rem, 7.2vw, 6.35rem)",
      "caseHero": "clamp(3.25rem, 8vw, 7rem)",
      "display": "clamp(2.45rem, 5vw, 4.75rem)",
      "caseDisplay": "clamp(2rem, 4vw, 3.6rem)",
      "bridge": "clamp(1.35rem, 3vw, 2.7rem)",
      "body": "clamp(1rem, 1.6vw, 1.13rem)",
      "summary": "clamp(1rem, 2vw, 1.3rem)",
      "nav": "0.84rem",
      "navMobile": "0.72rem",
      "ui": "0.9rem",
      "link": "0.86rem",
      "label": "0.78rem",
      "tag": "0.75rem",
      "index": "0.74rem",
      "note": "0.72rem",
      "title": "1.1rem"
    },
    "lineHeights": {
      "tight": 0.96,
      "body": 1.75,
      "bridge": 1.1
    },
    "weights": {
      "heading": 760,
      "title": 720,
      "nav": 650,
      "ui": 760,
      "label": 800
    },
    "letterSpacing": "0"
  },
  "radii": {
    "sm": "6px",
    "md": "8px",
    "pill": "999px"
  },
  "layout": {
    "mediaAspectDesktop": "16 / 10",
    "mediaAspectGallery": "16 / 11"
  },
  "motion": {
    "duration": "180ms",
    "easing": "ease",
    "hoverLift": "translateY(-2px)",
    "reducedMotion": true
  },
  "japaneseInfluence": {
    "allowed": [
      "ma spacing",
      "shoji grid rhythm",
      "thin dividers",
      "subtle enso mark",
      "washi-like neutral texture",
      "quiet asymmetry"
    ],
    "avoid": [
      "decorative kanji",
      "temples",
      "samurai",
      "anime",
      "random ornaments",
      "visual clutter"
    ]
  },
  "copyRules": {
    "headings": "short and direct",
    "buttons": "one or two words when possible",
    "projectDescriptions": "objective and proof-oriented"
  }
}
