{
  "name": "gabriel-nbs-portfolio",
  "version": "1.0.0",
  "priority": ["DESIGN.md", "styles.json", "provided screenshots", "existing components", "premium references"],
  "colors": {
    "canvas": "#f7f7f5",
    "paper": "#ffffff",
    "ink": "#18181b",
    "muted": "#68645f",
    "line": "#dedbd4",
    "soft": "#eeece7",
    "accent": "#a43f2f",
    "accentDark": "#7f2d22"
  },
  "typography": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "headingWeight": 760,
    "bodyLineHeight": 1.75,
    "letterSpacing": "0"
  },
  "radii": {
    "sm": "6px",
    "md": "8px",
    "pill": "999px"
  },
  "layout": {
    "contentMax": "1180px",
    "sectionSpace": "clamp(5rem, 10vw, 9rem)",
    "gridGap": "clamp(1.25rem, 3vw, 3rem)",
    "mediaAspectDesktop": "16 / 10",
    "mediaAspectGallery": "16 / 11"
  },
  "motion": {
    "duration": "180ms",
    "easing": "ease",
    "hoverLift": "translateY(-2px)",
    "reducedMotion": true
  },
  "japaneseInfluence": {
    "allowed": ["ma spacing", "shoji grid rhythm", "thin dividers", "subtle enso mark", "washi-like neutral texture", "quiet asymmetry"],
    "avoid": ["decorative kanji", "temples", "samurai", "anime", "random ornaments", "visual clutter"]
  },
  "copyRules": {
    "headings": "short and direct",
    "buttons": "one or two words when possible",
    "projectDescriptions": "objective and proof-oriented"
  }
}
